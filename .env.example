# RecallRoot application
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://localhost:8000
WEB_HOST=127.0.0.1
WEB_PORT=3000
# Server-side Next.js proxy target. scripts/dev.py derives this from API_PORT
# when it is omitted; set it explicitly when running the web app separately.
RECALLROOT_API_URL=http://127.0.0.1:8000
RECALLGRAPH_ENVIRONMENT=development
RECALLGRAPH_DEBUG=false
RECALLGRAPH_DATABASE_URL=sqlite:///./data/recallroot.db
RECALLGRAPH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RECALLGRAPH_TELEMETRY_SERVICE_NAME=recallroot-api
RECALLGRAPH_TRUSTED_REFUND_THRESHOLD=10000

# Agent decision provider. Deterministic is the zero-dependency default.
# To demonstrate local model inference, run Ollama, pull the configured model,
# and change the provider to ollama. No hosted-model API key is used.
RECALLGRAPH_DECISION_PROVIDER=deterministic
RECALLGRAPH_OLLAMA_BASE_URL=http://127.0.0.1:11434
RECALLGRAPH_OLLAMA_MODEL=llama3.2:3b
RECALLGRAPH_OLLAMA_TIMEOUT_SECONDS=12

# OpenTelemetry -> the SigNoz ingester generated by Foundry
# The API uses OTLP/HTTP and appends /v1/{traces,metrics,logs}.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
RECALLGRAPH_OTEL_EXPORT_TIMEOUT_SECONDS=3

# SigNoz UI/API and Foundry-managed MCP server
SIGNOZ_URL=http://localhost:3301
SIGNOZ_MCP_URL=http://localhost:8001/mcp
RECALLGRAPH_SIGNOZ_MCP_URL=http://localhost:8001/mcp
RECALLGRAPH_SIGNOZ_API_URL=http://localhost:3301
RECALLGRAPH_SIGNOZ_UI_URL=http://localhost:3301
RECALLGRAPH_SIGNOZ_QUERY_LOOKBACK_HOURS=24
RECALLGRAPH_SIGNOZ_TIMEOUT_SECONDS=5
# Create a service-account key in SigNoz Settings before direct API verification
# or provisioning. Never commit the populated value.
SIGNOZ_API_KEY=
# Exact name of an existing SigNoz notification channel. Required only when
# provisioning infra/signoz/alert-rule.template.json. For a fully local demo,
# create a webhook channel targeting:
# http://host.docker.internal:8000/integrations/signoz-alerts
# Docker-to-host webhook delivery requires API_HOST=0.0.0.0 for the recording
# session. Keep the loopback default when webhook delivery is not being shown.
SIGNOZ_ALERT_CHANNEL=

# Demo client behavior
DEMO_CUSTOMER_ID=demo-customer
DEMO_REFUND_AMOUNT=35000
DEMO_REFUND_REASON="Duplicate charge"
DEMO_HTTP_TIMEOUT_SECONDS=15
TELEMETRY_LOOKBACK_MINUTES=30
TELEMETRY_RETRY_SECONDS=45
# SigNoz evaluates every minute with an internal delayed window; strict alert
# history verification may need roughly three minutes after the unsafe run.
TELEMETRY_ALERT_RETRY_SECONDS=240
